                >
                  <span
                    class="
                              px-2 py-1 bg-slate-900/50 border-slate-800 text-slate-400
                              rounded-md border text-[10px] font-bold uppercase tracking-wider transition-all cursor-default
                            "
                  >
                    secret
                  </span>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
    >
      <footer
        class="mt-12 pt-6 border-t border-slate-800 text-center text-sm text-slate-500"
      >
        <button
          class="hover:text-slate-300 underline underline-offset-4"
          type="button"
        >
